# ---------------------------------------------------------------------------
# این فایل را کپی کن به اسم  .env  و مقدارها را پر کن
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- تلگرام ---
# از  https://my.telegram.org  →  API development tools  بگیر
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# از  @BotFather  بگیر
BOT_TOKEN=123456789:AA...your-bot-token...

# آیدی عددی کاربرهایی که اجازه دارند با بات کار کنند (با کاما جدا کن).
# آیدی خودت را از  @userinfobot  بگیر. خالی = همه اجازه دارند (توصیه نمی‌شود).
ADMIN_IDS=123456789

# --- سایت ---
BASE_URL=https://www.soolakhi.com/

# الگوی آدرس صفحه‌بندی؛ {page} جای شماره صفحه می‌نشیند.
# وردپرس معمولاً اینطور است. اگر فرق داشت عوض کن (مثلاً: https://www.soolakhi.com/?paged={page})
LISTING_URL_TEMPLATE=https://www.soolakhi.com/page/{page}/

# --- سلکتورهای CSS برای اسکرپ (در صورت نیاز با حالت تست تنظیم کن) ---
# هر آیتم ویدیو در لیست با این سلکتور پیدا می‌شود:
ITEM_SELECTOR=article
# عنوان و لینک صفحه ویدیو داخل هر آیتم:
TITLE_SELECTOR=h2 a, h3 a, .title a, .entry-title a, a[rel="bookmark"]
# عکس (تامبنیل) داخل هر آیتم:
THUMB_SELECTOR=img

# --- تنظیمات دانلود ---
# حداکثر حجم مجاز هر فایل به مگابایت (سقف بات تلگرام ~۲۰۰۰ است)
MAX_FILESIZE_MB=1950
# کیفیت/فرمت انتخابی yt-dlp. برای کم‌کردن حجم می‌توانی محدود کنی، مثلاً:
#   best[height<=720][ext=mp4]/best[height<=720]/best
YTDLP_FORMAT=best[ext=mp4]/best
# تعداد ویدیوهایی که در هر /scan فرستاده می‌شود
ITEMS_PER_SCAN=8

# در صورت نیاز به ورود (کوکی). فایل کوکی netscape؛ خالی بگذار اگر لازم نیست.
COOKIES_FILE=
