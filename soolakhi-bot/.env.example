# ---------------------------------------------------------------------------
# این فایل را کپی کن به اسم  .env  و مقدارها را پر کن:   cp .env.example .env
# ---------------------------------------------------------------------------

# --- تلگرام (برای نسخه‌ی پیش‌فرض فقط همین دو خط لازم است) ---
# از ربات  @BotFather  بگیر:
BOT_TOKEN=123456789:AA...your-bot-token...
# آیدی عددی خودت از  @userinfobot  (خالی = همه اجازه دارند، توصیه نمی‌شود):
ADMIN_IDS=123456789

# --- سایت ---
BASE_URL=https://www.soolakhi.com/
# الگوی صفحه‌بندی؛ {page} جای شماره صفحه می‌نشیند. (وردپرس معمولاً اینطور است)
LISTING_URL_TEMPLATE=https://www.soolakhi.com/page/{page}/

# --- سلکتورهای CSS (در صورت نیاز با `python scraper.py --page 1` تنظیم کن) ---
ITEM_SELECTOR=article
TITLE_SELECTOR=h2 a, h3 a, .title a, .entry-title a, a[rel="bookmark"]
THUMB_SELECTOR=img

# --- دانلود ---
# سقف حجم ارسال با توکن ساده (تلگرام ~۵۰ مگابایت اجازه می‌دهد):
SEND_LIMIT_MB=48
# کیفیت/فرمت yt-dlp. برای کم‌کردن حجم مثلاً: best[height<=720][ext=mp4]/best[height<=720]/best
YTDLP_FORMAT=best[ext=mp4]/best
# تعداد ویدیو در هر /scan:
ITEMS_PER_SCAN=8
# فایل کوکی netscape اگر سایت نیاز به ورود دارد (وگرنه خالی):
COOKIES_FILE=

# --- فقط برای نسخه‌ی ۲ گیگی (bot_2gb.py) — از my.telegram.org ---
# سقف حجم برای نسخه‌ی ۲ گیگی:
MAX_FILESIZE_MB=1950
API_ID=
API_HASH=
