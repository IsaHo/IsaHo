# --- Required ---------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Target chat/channel id. For a private chat, DM @userinfobot to get your id.
# For a channel/group, add the bot as admin and use the @channelusername or the
# numeric -100... id.
TELEGRAM_CHAT_ID=123456789

# --- Source ------------------------------------------------------------------
# One or more pages to scan, comma-separated.
SOURCE_URLS=https://gspotwizard.com/

# --- Behaviour ---------------------------------------------------------------
# Seconds between scans.
POLL_INTERVAL=300
# Max items sent per scan (keeps the first run from flooding the chat).
MAX_PER_CYCLE=10
# Bot upload cap (Telegram allows up to 50 MB).
MAX_FILE_MB=50
# Where the "already sent" list is stored.
STATE_FILE=sent_state.json

# --- Optional tuning ---------------------------------------------------------
# If the generic extractor misses the site's markup, point it at the exact
# element + attribute that holds the media URL, e.g.:
#   MEDIA_SELECTOR=a.gif
#   MEDIA_ATTR=href
MEDIA_SELECTOR=
MEDIA_ATTR=href
# If the site needs an age-gate / session cookie, paste the Cookie header here.
COOKIE=
# LOG_LEVEL=INFO
